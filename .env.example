# Server
PORT=4000
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_NAME=Travel Administrator
CLIENT_ORIGIN=http://localhost:5173

# Email (Resend HTTPS API — required on Render Free; SMTP is blocked)
RESEND_API_KEY=
RESEND_FROM=Consulta Travel <onboarding@resend.dev>
NOTIFY_ADMIN_EMAIL=
# Optional hidden CC list (comma-separated). Never shown on the website.
NOTIFY_EXTRA_EMAILS=

