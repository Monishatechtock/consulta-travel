# Server
PORT=4000
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_NAME=Travel Administrator
CLIENT_ORIGIN=http://localhost:5173

# Who receives form submissions (shown on website footer)
NOTIFY_ADMIN_EMAIL=jsathishpaul@gmail.com
# Optional hidden recipients (comma-separated). Never shown on the website.
NOTIFY_EXTRA_EMAILS=

# ------------------------------------------------------------
# EMAIL ON RENDER (required)
# Render Free blocks SMTP. Use Resend HTTPS API:
# 1) Create account at https://resend.com
# 2) Create an API key
# 3) Set RESEND_API_KEY in Render Environment
# 4) Until your domain is verified, use:
#      RESEND_FROM=Consulta Travel <onboarding@resend.dev>
# 5) After verifying cbciedubase.org in Resend, you can use:
#      RESEND_FROM=Consulta Travel <info@cbciedubase.org>
# ------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM=Consulta Travel <onboarding@resend.dev>

# Local-only SMTP fallback (works on your PC, NOT on Render Free)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Consulta Travel <info@cbciedubase.org>
